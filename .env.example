# ──────────────────────────────────────────────
# dx-doc — Environment Variables
# Copy this file to .env and fill in the values.
#
# This file holds INSTANCE-level configuration only — the operator's
# infrastructure and secrets. Per-COMPANY configuration (SSO connection
# details, which login methods a company accepts, supported locales,
# branding, catalogue defaults, SMTP override) lives in the database and
# is managed by each company's Admin through the web UI. See ADR-0014.
#
# See docs/architecture/deployment.md and README.md for the full reference.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_URL=http://localhost:3001
APP_SECRET=change-me-to-a-random-string
APP_ENV=development
# Fallback interface language used before any company context is known
# (e.g. the instance-administration portal). Each company sets its own
# supported locales and default in the database (REQ-NFR-010).
APP_DEFAULT_LOCALE=en

# ── Database ─────────────────────────────────
# Selects the persistence adapter. 'sqlite' is the default and the only
# adapter through R1; 'mariadb' and 'postgres' arrive in R2 (ADR-0020).
DB_DRIVER=sqlite

# Used when DB_DRIVER=sqlite (default, no separate database service):
DB_FILE=./var/db/dxdoc.sqlite

# Used when DB_DRIVER=mariadb or DB_DRIVER=postgres (R2 only):
# DB_HOST=localhost
# DB_PORT=3306          # 3306 for mariadb, 5432 for postgres
# DB_NAME=dxdoc
# DB_USER=dxdoc
# DB_PASSWORD=change-me
# DB_POOL_SIZE=10
# DB_SSL_MODE=preferred

# ── Object Storage (S3-compatible) ───────────
# Any provider implementing the S3 API works behind this port (REQ-FDN-006).
#   - AWS S3: set STORAGE_S3_ENDPOINT to the region-specific endpoint
#     (e.g. https://s3.<region>.amazonaws.com) — it is required by this
#     adapter; use an IAM user scoped to a single bucket for the
#     access/secret keys.
#   - MinIO (local dev / self-hosted): endpoint is your MinIO URL,
#     STORAGE_S3_FORCE_PATH_STYLE=true.
#   - Backblaze B2: S3-compatible endpoint (e.g. s3.<region>.backblazeb2.com),
#     access/secret keys are a B2 "application key" pair,
#     STORAGE_S3_FORCE_PATH_STYLE=true.
#   - Cloudinary: NOT S3-compatible (its own upload API, not the S3 wire
#     protocol) — it cannot be configured through these variables. Using it
#     requires implementing a new adapter behind the storage port rather
#     than pointing these variables at it.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=dxdoc-assets
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true
# Optional. Public URL prefix used to build asset URLs (e.g. a CDN domain).
# Defaults to "<STORAGE_S3_ENDPOINT>/<STORAGE_S3_BUCKET>" when unset.
# STORAGE_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=10485760
IMAGE_MAX_DIMENSION=2000

# ── First-run bootstrap ──────────────────────
# Read ONCE, only when the database has no users, to create the first
# administrator (instance_admin). Ignored on every subsequent start.
# Change the password at first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-first-login

# ── Search ───────────────────────────────────
# 'pagefind' is the default: in-process, no account, no egress (REQ-FDN-007).
SEARCH_DRIVER=pagefind
SEARCH_INDEX_PATH=./var/search
# A hosted adapter (e.g. Algolia) arrives R3 behind the same port
# (REQ-FDN-022) for organisations that would rather buy typo-tolerant
# search than run the default. Not configurable yet — it will add its own
# SEARCH_ALGOLIA_* (or equivalent) credential variables when it ships.

# ── Email (SMTP fallback) ────────────────────
# Instance-wide default. A company may override host/port/user/password/
# from-address in the database; the company setting takes precedence when
# present (ADR-0014).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TLS=true

# ── Error Tracking ───────────────────────────
SENTRY_DSN=

# ── Audit ────────────────────────────────────
AUDIT_RETENTION_MONTHS=24

# ── Session ──────────────────────────────────
AUTH_SESSION_TTL=8h

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
