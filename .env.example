# ──────────────────────────────────────────────
# dx-doc — Environment Variables
# Copy this file to .env and fill in the values.
# See docs/architecture/deployment.md for details.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-random-string
APP_ENV=development
APP_DEFAULT_LOCALE=en

# ── Database (MariaDB) ───────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dxdoc
DB_USER=dxdoc
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_SSL_MODE=preferred

# ── Object Storage (S3-compatible) ───────────
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=dxdoc-assets
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=10485760
IMAGE_MAX_DIMENSION=2000

# ── Search (Algolia) ─────────────────────────
SEARCH_DRIVER=algolia
ALGOLIA_APP_ID=your-app-id
ALGOLIA_ADMIN_API_KEY=your-admin-api-key
ALGOLIA_INDEX_PREFIX=trackdocs_dev

# ── Authentication ───────────────────────────
AUTH_PASSWORD_ENABLED=true
AUTH_SESSION_TTL=8h
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPES=openid profile email

# ── Email (SMTP fallback) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TLS=true

# ── Error Tracking ───────────────────────────
SENTRY_DSN=

# ── Audit ────────────────────────────────────
AUDIT_RETENTION_MONTHS=24

# ── Logging ──────────────────────────────────
LOG_LEVEL=info

# ── Development ──────────────────────────────
AUTO_MIGRATE=true