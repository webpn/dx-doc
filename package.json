{
  "name": "dx-doc",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, white-label platform for documenting digital analytics tracking plans",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "echo 'Development server not yet configured'",
    "build": "echo 'Build not yet configured'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo 'E2E tests not yet configured'",
    "test:coverage": "echo 'Coverage not yet configured'",
    "db:migrate": "echo 'Migrations not yet configured'",
    "db:seed:demo": "echo 'Demo seed not yet configured'",
    "docs:check-links": "node scripts/docs-links.mjs check",
    "docs:sync-links": "node scripts/docs-links.mjs sync",
    "docs:check-index": "node scripts/docs-index.mjs check",
    "docs:generate-index": "node scripts/docs-index.mjs generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "~8.66.0",
    "@typescript-eslint/parser": "~8.66.0",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-react": "~7.37.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "prettier": "~3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.66.0",
    "vitest": "^4.1.10"
  }
}
