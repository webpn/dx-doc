{
  "name": "dx-doc",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, white-label platform for documenting digital analytics tracking plans",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env src/api/server.ts",
    "dev:web": "vite",
    "start": "tsx --env-file-if-exists=.env src/api/server.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:coverage": "echo 'Coverage not yet configured'",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts up",
    "db:seed:demo": "echo 'Demo seed not yet configured'",
    "docs:check-links": "node scripts/docs-links.mjs check",
    "docs:sync-links": "node scripts/docs-links.mjs sync",
    "docs:check-index": "node scripts/docs-index.mjs check",
    "docs:generate-index": "node scripts/docs-index.mjs generate"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "~8.66.0",
    "@typescript-eslint/parser": "~8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-react": "~7.37.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "~3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/node": "10.70.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.0",
    "kysely": "^0.29.5",
    "lucide-react": "^1.33.0",
    "nodemailer": "^9.0.5",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
