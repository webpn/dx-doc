{
  "name": "dx-doc",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, white-label platform for documenting digital analytics tracking plans",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo 'E2E tests not yet configured'",
    "test:coverage": "echo 'Coverage not yet configured'",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:seed:demo": "echo 'Demo seed not yet configured'",
    "docs:check-links": "node scripts/docs-links.mjs check",
    "docs:sync-links": "node scripts/docs-links.mjs sync",
    "docs:check-index": "node scripts/docs-index.mjs check",
    "docs:generate-index": "node scripts/docs-index.mjs generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "~8.66.0",
    "@typescript-eslint/parser": "~8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "dbmate": "^2.35.0",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-react": "~7.37.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "pagefind": "^1.5.2",
    "prettier": "~3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  }
}
